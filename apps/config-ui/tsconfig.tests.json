{
  "extends": [
    "@cbnventures/nova/presets/tsconfig/dx-essentials.json",
    "@cbnventures/nova/presets/tsconfig/dx-strict.json",
    "@cbnventures/nova/presets/tsconfig/runtime-browser.json",
    "@cbnventures/nova/presets/tsconfig/tool-vite.json"
  ],
  "compilerOptions": {
    "jsx": "preserve",
    "paths": {
      "@homebridge/plugin-ui-utils/dist/ui.interface": [
        "../../node_modules/@homebridge/plugin-ui-utils/dist/ui.interface.d.ts"
      ]
    },
    "types": [
      "node",
      "lodash",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "src/tests/**/*.ts",
    "src/tests/**/*.tsx",
    "vite-env.d.ts",
    "vitest.config.mts",
    "vitest.setup.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
