          "from": "./packages/homebridge-adt-pulse/build",
          "to": "./build"
        },
        {
          "from": "./apps/config-ui/build",
          "to": "./build/config-ui/public"
        },
        {
          "from": "./packages/homebridge-adt-pulse/bin",
          "to": "./bin"
        },
        {
          "from": "./packages/homebridge-adt-pulse/config.schema.json",
          "to": "./config.schema.json"
        },
        {
          "from": "./packages/homebridge-adt-pulse/package.json",
          "to": "./package.json"
        },
        {
          "from": "./packages/homebridge-adt-pulse/README.md",
          "to": "./README.md"
        },
        {
          "from": "./packages/homebridge-adt-pulse/LICENSE",
          "to": "./LICENSE"
        }
      ]
    },
    "documentation": {
      "build": [
        "./apps/docs"
      ],
      "sources": [
        {
          "from": "./apps/docs/build",
          "to": "./"
        }
      ]
    }
  },
