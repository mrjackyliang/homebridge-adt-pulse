{
  "extends": [
    "@cbnventures/nova/presets/tsconfig/dx-essentials.json",
    "@cbnventures/nova/presets/tsconfig/dx-strict.json",
    "@cbnventures/nova/presets/tsconfig/role-source.json",
    "@cbnventures/nova/presets/tsconfig/runtime-node.json",
    "@cbnventures/nova/presets/tsconfig/fw-homebridge.json"
  ],
  "compilerOptions": {
    "noEmitOnError": false,
    "outDir": "./build",
    "rootDir": "./src",
    "types": [
      "@types/node"
    ],
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "src/tests"
  ]
}
