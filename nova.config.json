  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "release"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 30,
      "build": [
        "./apps/config-ui",
        "./apps/docs",
        "./packages/homebridge-adt-pulse"
      ],
      "deploy": [
        {
          "to": "npm",
          "path": "./packages/homebridge-adt-pulse",
          "artifact": "homebridge-adt-pulse"
        },
        {
          "to": "github-packages",
          "path": "./packages/homebridge-adt-pulse",
          "artifact": "homebridge-adt-pulse"
        },
        {
          "to": "github-pages",
          "path": "./apps/docs",
          "artifact": "documentation"
        }
      ]
    }
  ],
