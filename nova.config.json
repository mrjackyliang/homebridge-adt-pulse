    "documentation": "https://mrjackyliang.github.io/homebridge-adt-pulse/",
    "npm": "https://www.npmjs.com/package/homebridge-adt-pulse",
    "fundSources": [
      "https://github.com/sponsors/mrjackyliang",
      "https://liang.nyc/paypal"
    ]
  },
